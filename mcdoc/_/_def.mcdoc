use super::super::def::BuildInfo
type SlimecoreData = ::slimecore::mcdoc::data::Data

struct VariableRegister {
    [string]: any
}
dispatch minecraft:storage[scdev:_] to struct {
    /// top level
    t: VariableRegister,
    /// impl
    v: VariableRegister,
    /// util
    u: VariableRegister,
    /// in-scope temp
    x: VariableRegister,
    const: struct {
        chat_marker: ::java::util::text::Text
    },
    data: struct {
        pre_rebuild: SlimecoreData,
    },
    // for reentrant functions
    eval: [struct {
        in: any,
        out: any,
        v: VariableRegister,
    }]
}
dispatch minecraft:storage[scdev:_/in] to struct {
    [any]: any
}
dispatch minecraft:storage[scdev:_/out] to struct {
    [any]: any
}